<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelReservation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelReservation.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js" defer></script>
</head>



<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a  style="margin: -10px 0 -10px 30px" class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/logo.png" alt="Logo" style="height: 60px; width: 60px;" />
                </a>
                
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ">
                        <li class="nav-item">
                            <a class="nav-link text-dark" style="font-size: 20px" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        { 
                            <li class="nav-item">
                                @if (User.IsInRole("Hotel"))
                                {
                                    <a class="nav-link text-dark" asp-area="" style="font-size: 20px" asp-controller="Hotel" asp-action="HotelProfile">Profile</a>
                                }
                                else if (User.IsInRole("Customer"))
                                {
                                    <a class="nav-link text-dark" asp-area="" style="font-size: 20px" asp-controller="Customer" asp-action="CustomerProfile">Profile</a>
                                }
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" style="font-size: 20px" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" style="font-size: 20px" asp-area="" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                       
                    </ul>


    <ul class="navbar-nav ms-auto"  style="margin-right:30px ">

        @if (User.Identity.IsAuthenticated)
                    {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                    <button type="submit" class="nav-link btn btn-link text-dark" style="font-size: 20px; border:none; padding:0; background:none;">Logout</button>
                                </form>
                            </li>
                    }
                    else
                    {
                            <li class="nav-item">
                                <a class="nav-link text-dark"  style="font-size: 20px" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"  style="font-size: 20px" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                    }

                    </ul>

                </div>
            </div>
        </nav>
    </header>
<div class="container-fluid">
        <main role="main" class="W-100" >
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - HotelReservation - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
