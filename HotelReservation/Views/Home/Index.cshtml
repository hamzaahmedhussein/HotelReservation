@using HotelReservation.ViewModels
@model HomePagePagedResult<RoomViewModel>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

@{
    var currentUserId = UserManager.GetUserId(User);
    var hotel = _context.Hotels.FirstOrDefault(h => h.ApplicationUserId == currentUserId);
    bool isOwner = hotel != null; 
}

<div class="container-fluid bg-image"
     style="background-image: url('@Url.Content("~/Images/hero.jpg")'); 
            background-size: cover; 
            background-position: center; 
            height: 900px; 
            width: 100%;
            display: flex;
            justify-content: center;
            align-content: center">
    
     
    <div class="container mt-5 d-flex flex-column align-items-center">
    <!-- Title -->
    <div class="text-center text-primary mb-4">
        <h1>Find Your Next Stay</h1>
    </div>

    <!-- Form Card -->
    <div class="card shadow-lg p-4" style="max-width: 1000px; border-radius: 15px;">

            <form method="get" asp-controller="Home" asp-action="Index">
                <div class="row g-3">
                    <!-- First Row (3 Inputs) -->
                    <div class="col-md-4">
                        <input type="text" class="form-control" id="Address" name="Address" placeholder="Street" value="@Model.Filter?.Address" />
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control" id="City" name="City" placeholder="City" value="@Model.Filter?.City" />
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control" id="State" name="State" placeholder="State" value="@Model.Filter?.State" />
                    </div>

                    <!-- Second Row (2 Inputs) -->
                    <div class="col-md-6">
                        <input type="number" class="form-control" id="BedsNumber" name="BedsNumber" placeholder="Beds Number" />
                    </div>
                    <div class="col-md-6">
                        <input type="number" class="form-control" id="PricePerNight" name="PricePerNight" placeholder="Price Per Night" />
                    </div>

                    <!-- Third Row (2 Inputs) -->
                    <div class="col-md-6">
                        <input type="date" class="form-control" id="CheckInDate" title="Check In Date" name="CheckInDate" placeholder="Check In Date" />
                    </div>
                    <div class="col-md-6">
                        <input type="date" class="form-control" id="CheckOutDate" name="CheckOutDate" title="Check Out Date" placeholder="Check Out Date" />
                    </div>

                    <!-- Submit Button (Centered) -->
                    <div class="col-12 d-flex justify-content-center mt-3">
                        <button type="submit" class="btn btn-primary w-25">Search</button>
                    </div>
                </div>
                <!-- Hidden Inputs -->
                <input type="hidden" name="PageNumber" value="@Model.CurrentPage" />
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
            </form>
        </div>
</div>


</div>

    


<div class="row mt-4">
    @foreach (var room in Model.Results)
    {
        var isRoomOwner = isOwner && room.HotelId == hotel.Id;

        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card shadow-sm border-0 rounded-lg overflow-hidden">
        @if (room.RoomPicture != null && room.RoomPicture.Length > 0)
        {
            var base64Image = Convert.ToBase64String(room.RoomPicture);
            <img src="data:image/jpeg;base64,@base64Image" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Room Picture">
        }
        else
        {
            <div class="d-flex justify-content-center align-items-center text-muted" style="height: 200px; background-color: #f5f5f5;">
                No Image Available
            </div>
        }

        <div class="card-body text-center">
            <h5 class="card-title mb-2 fw-bold text-dark">Room #@room.RoomNumber</h5>
            <p class="card-text mb-1 text-muted">
                <i class="fas fa-bed me-1 text-secondary"></i> Beds: <span class="fw-semibold text-dark">@room.BedsNumber</span>
            </p>
            <p class="card-text mb-3 text-muted">
                <i class="fas fa-dollar-sign me-1 text-success"></i> Price per Night: <span class="fw-semibold text-dark">$@room.PricePerNight</span>
            </p>

            <div class="d-flex gap-2 justify-content-center">
            @if (isRoomOwner)
            {
                <a href="@Url.Action("RoomDetails", "Hotel", new { Id = room.Id })" class="btn btn-outline-primary btn-sm ">
                    <i class="fas fa-info-circle"></i> Details
                </a>
                <a href="@Url.Action("UpdateRoom", "Hotel", new { Id = room.Id })" class="btn btn-outline-warning btn-sm">
                    <i class="fas fa-edit"></i> Update
                </a>
                <a href="@Url.Action("DeleteRoom", "Hotel", new { Id = room.Id })" class="btn btn-outline-danger btn-sm">
                    <i class="fas fa-trash-alt"></i> Delete
                </a>
            }
            else
            {
                <a href="@Url.Action("CreateReservation", "Customer", new { id = room.Id })" class="btn btn-success btn-sm w-100" style="border-radius: 20px;">
                    <i class="fas fa-plus-circle"></i> Add Reservation
                </a>
            }        </div>

        </div>
    </div>
</div>
    }
</div>

<nav aria-label="Page navigation example">
    <ul class="pagination justify-content-center mt-4">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.CurrentPage - 1, pageSize = Model.PageSize })" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = Model.PageSize })">@i</a>
            </li>
        }
        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.CurrentPage + 1, pageSize = Model.PageSize })" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
    </ul>
</nav>

<style>
    .room-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: box-shadow 0.3s ease;
        border: 1px solid #dee2e6;
        border-radius: 8px;
    }

        .room-card:hover {
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            border-color: #007bff;
        }

    .card-body {
        padding: 1rem;
    }

    .btn-action {
        margin: 0.5rem;
        color: #fff;
        opacity: 0.9;
        transition: opacity 0.2s;
        width: 100%; /* Full width on small screens */
    }

        .btn-action:hover {
            opacity: 1;
        }

    .btn-details {
        background-color: #007bff; /* Blue */
    }

    .btn-update {
        background-color: #28a745; /* Green */
    }

    .btn-delete {
        background-color: #dc3545; /* Red */
    }

    .btn-reserve {
        background-color: #ffc107; /* Yellow */
    }

    .room-image {
        height: 200px;
        object-fit: cover;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        width: 100%;
    }

    .room-details {
        flex: 1;
        padding: 1rem;
    }

    .room-actions {
        padding: 1rem;
        text-align: center;
    }
</style>
